# Local Compose: API server
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://battery:battery@postgres:5432/battery_monitor
BATTERY_MONITOR_API_TOKEN=change-me

# Local Compose: Prisma Studio
PRISMA_STUDIO_PORT=5555

# Local Compose: PostgreSQL
POSTGRES_USER=battery
POSTGRES_PASSWORD=battery
POSTGRES_DB=battery_monitor

# Optional local OpenTelemetry tracing
# OTEL_SERVICE_NAME=battery-monitor
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
