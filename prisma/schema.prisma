generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model BatterySample {
  id                    BigInt   @id @default(autoincrement())
  deviceId              String   @map("device_id")
  hostname              String?
  osName                String?  @map("os_name")
  batteryName           String?  @map("battery_name")
  status                String?
  source                String   @default("battery_collector")
  collectedAt           DateTime @map("collected_at") @db.Timestamptz(6)
  receivedAt            DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  socPercent            Decimal? @map("soc_percent") @db.Decimal(5, 2)
  designedCapacityMah   Int?     @map("designed_capacity_mah")
  currentCapacityMah    Int?     @map("current_capacity_mah")
  fullChargeCapacityMah Int?     @map("full_charge_capacity_mah")
  currentMa             Int?     @map("current_ma")
  voltageMv             Int?     @map("voltage_mv")
  powerMw               Int?     @map("power_mw")
  cycleCount            Int?     @map("cycle_count")
  temperatureC          Decimal? @map("temperature_c") @db.Decimal(5, 2)
  healthPercent         Decimal? @map("health_percent") @db.Decimal(5, 2)
  extra                 Json     @default("{}")

  @@index([deviceId, collectedAt(sort: Desc)], map: "battery_samples_device_collected_at_idx")
  @@map("battery_samples")
}
